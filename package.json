{
  "name": "consola-entrada",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy localStorage preferredLanguage baseLocale --emit-ts-declarations --silent",
    "predev": "npm run i18n",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run i18n",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "pretest": "npm run i18n",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "manifold-3d": "^3.5.0",
    "svg2pdf.js": "^2.8.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.28.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/three": "^0.180.0",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
